# 复制成 .env 后填入你自己的值。.env 已在 .gitignore 中，永远不会提交。
#
# 申请方式：去模型厂商官网注册 -> 创建 API Key -> 粘贴到下面。
# 注意：请使用你自己申请的 key，不要复用任何其他工具里已有的 key，
#       否则你自己的用量与花费会不清晰。

DEEPSEEK_API_KEY=sk-your-own-key-here

# 模型名（可替换，便于对比不同模型）
MODEL_NAME=deepseek-chat

# ---- 成本护栏（元）。超出即中止并报错，避免失控 ----
MAX_CNY_PER_CALL=0.10
MAX_CNY_PER_DAY=2.00

# ---- 单价（元 / 百万 token），用于本地估算成本 ----
# 若厂商调价，改这里即可，代码不用动。
PRICE_INPUT_PER_MTOK=2.00
PRICE_OUTPUT_PER_MTOK=8.00
