# 复制成 .env 后填入你自己的值。.env 已在 .gitignore 中，永远不会提交。
#
# 申请方式：去模型厂商官网注册 -> 创建 API Key -> 粘贴到下面。
# 注意：请使用你自己申请的 key，不要复用任何其他工具里已有的 key，
#       否则你自己的用量与花费会不清晰。

DEEPSEEK_API_KEY=sk-your-own-key-here

# 模型名（可替换，便于对比不同模型）
MODEL_NAME=deepseek-chat

# ---- 成本护栏（元）。超出即中止并报错，避免失控 ----
MAX_CNY_PER_CALL=0.10
MAX_CNY_PER_DAY=2.00

# ---- 单价（元 / 百万 token），用于本地估算成本 ----
# 若厂商调价，改这里即可，代码不用动。
PRICE_INPUT_PER_MTOK=2.00
PRICE_OUTPUT_PER_MTOK=8.00

# ==========================================================================
# 有谱掌柜（clerk/）支付通道配置 —— 详见 docs/30-支付接入结论.md
# 规则：四项核心凭证配齐 → 收银台自动切真实支付宝通道；
#       缺任何一项 → 诚实显示"通道接入中"（FakeAdapter），其余功能不受影响。
# ⚠️ 私钥只放这里（.env 已被 .gitignore），永不进仓库、永不进前端。
# ==========================================================================

# ---- Vibe Pay · AI网页应用收款（人类顾客：30 天通行证）----
ALIPAY_APP_ID=
# 应用私钥（PKCS8，base64 一行或 PEM 均可）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（平台生成，用于异步通知验签）
ALIPAY_PUBLIC_KEY=
# 异步通知地址：必须公网 HTTPS、无重定向（部署后填 https://你的域名/api/pay/notify）
ALIPAY_NOTIFY_URL=
# 支付完成回跳地址（前端页面，如 https://你的域名/?pay_return=1）
ALIPAY_RETURN_URL=
# 你的 2088 收款账号（强烈建议填：开启通知 seller_id 强校验）
ALIPAY_SELLER_ID=
# 沙箱联调时换成沙箱网关（沙箱控制台 open.alipay.com/develop/sandbox/app）：
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# ---- Machine Pay · A2A 按量付费（Agent 顾客：402 协议，可选加分项）----
MACHINE_PAY_SELLER_ID=
MACHINE_PAY_SELLER_APP_ID=
MACHINE_PAY_SERVICE_ID=
MACHINE_PAY_SELLER_NAME=有谱掌柜

# ---- 联调开关：只在开发机设 1（开放模拟支付回调）；生产环境必须留空 ----
# CLERK_PAY_DEV=1
