# ---- 密钥与本地配置（绝不入库）----
.env
.env.local
*.key
data/alipay_*

# ---- 本地真实数据（只用于私下验证，绝不入库、绝不写进文档）----
data/local/
*.local.json
*.local.csv

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ---- 运行产物 ----
*.db
*.sqlite
*.sqlite3
*.log
eval/latest.json
eval/report.gen.md
exports/

# ---- 本地模型（向量检索那一级要先下模型，绝不能进仓库）----
# 约 100MB 的 ONNX 权重；固定版本可从 HuggingFace 重新下载，入库只会有害。
data/models/
*.onnx
*.safetensors

# 自动生成的评测数据集不入库：固定 seed + 一条命令即可逐字节复现，
# 入库只会带来巨大的无意义 diff。人读抽样（*.sample-*.md）与自检报告入库，作为证据。
eval/dataset-*.jsonl
eval/judged-reports.jsonl
eval/injected-artifacts.jsonl

# ---- 编辑器与系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
